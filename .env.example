# docker-compose 变量（复制为 .env 可覆盖默认值）
POSTGRES_DB=itops
POSTGRES_USER=itops
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_PORT=5432

# 生产环境务必替换为至少 32 位的随机字符串
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# 浏览器可访问的系统地址，二维码等公开链接使用
PUBLIC_BASE_URL=http://localhost:8080

# 允许跨域的前端地址，多个用逗号分隔（Docker 部署时同源，通常无需修改）
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# 初始管理员口令（仅在首次 seed 时生效）
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OPS_PASSWORD=Ops@12345
SEED_USER_PASSWORD=User@12345

# 第一阶段先预留；第五阶段启用 LLM 时使用
EMBEDDING_ENABLED=false
