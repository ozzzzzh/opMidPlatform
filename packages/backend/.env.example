NODE_ENV=development
PORT=3000

# 本地直连 Docker 中的 PostgreSQL
DATABASE_URL=postgresql://itops:change_me_db_password@localhost:5432/itops?schema=public

# 生产环境务必替换为至少 32 位的随机字符串
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173,http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# 附件目录（第二阶段使用）
UPLOAD_DIR=./uploads

# pgvector 语义检索开关（第三/五阶段使用）
EMBEDDING_ENABLED=false

# 初始账号口令（只在首次 seed 时生效）
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OPS_PASSWORD=Ops@12345
SEED_USER_PASSWORD=User@12345
